# Database Configuration
# For local SQLite (default fallback):
# DATABASE_URL=sqlite:///./resumex.db

# For Aiven PostgreSQL (Paste your Service URI from Aiven Console):
# Example: postgresql://avnadmin:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/defaultdb?sslmode=require
DATABASE_URL=postgresql://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST:PORT/defaultdb?sslmode=require

# Security / JWT
SECRET_KEY=resumex-super-secret-jwt-key-2026
ACCESS_TOKEN_EXPIRE_DAYS=7

# Allowed Origins for CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:3000

# Hugging Face LLM API
HUGGINGFACE_API_KEY=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
